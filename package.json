{
  "name": "3d-compare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs && node scripts/build-kernel.mjs",
    "dev": "vite --host 127.0.0.1 --port 43123",
    "prebuild": "node scripts/check-node.mjs && node scripts/build-kernel.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "prepreview": "node scripts/check-node.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 43123",
    "preverify:domain": "node scripts/check-node.mjs",
    "verify:domain": "node --experimental-strip-types scripts/verify-domain.mjs",
    "preverify:models": "node scripts/check-node.mjs",
    "verify:models": "node --experimental-strip-types scripts/verify-models.mjs",
    "preverify:kernel": "node scripts/check-node.mjs && node scripts/build-kernel.mjs",
    "verify:kernel": "cd kernel && cargo test --quiet && cd .. && node --experimental-strip-types scripts/verify-kernel.mjs",
    "preverify:rendering": "node scripts/check-node.mjs",
    "verify:rendering": "node --experimental-strip-types scripts/verify-rendering.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "preverify:budgets": "node scripts/check-node.mjs",
    "verify:budgets": "node --experimental-strip-types scripts/verify-budgets.mjs",
    "build:kernel": "node scripts/build-kernel.mjs",
    "assets:feet": "node scripts/build-feet-assets.mjs",
    "assets:foot-skins": "node scripts/build-foot-skins.mjs",
    "assets:previews": "node --experimental-strip-types scripts/build-model-previews.mjs",
    "assets:people": "node scripts/build-people-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
